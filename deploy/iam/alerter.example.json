{"Version":"2012-10-17","Statement":[
 {"Effect":"Allow","Action":["secretsmanager:GetSecretValue"],"Resource":"arn:aws:secretsmanager:REGION:ACCOUNT:secret:observability/alerter-*"},
 {"Effect":"Allow","Action":["sns:Publish"],"Resource":"arn:aws:sns:REGION:ACCOUNT:observability-oncall"},
 {"Effect":"Allow","Action":["ses:SendEmail"],"Resource":"arn:aws:ses:REGION:ACCOUNT:identity/example.com","Condition":{"StringEquals":{"ses:FromAddress":"observability@example.com"}}}
]}
