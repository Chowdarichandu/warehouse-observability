# Offline defaults. Live deployments use .env.live.example and per-service AWS secrets.
MODE=demo
DATABASE_URL=postgresql://obs:obs_local@127.0.0.1:55432/obs
JWT_SECRET=local-demo-only-change-before-live-use-32-characters
DEMO_PASSWORD=demo
COOKIE_SECURE=true
POLL_INTERVAL_SEC=120
PLATFORM_CHECK_SEC=60
WAREHOUSE_CHECK_SEC=900
DEMO_TICK_SEC=60
DEMO_RETRY_SEC=30
DEMO_ONBOARD_STEP_SEC=10
ALERT_INTERVAL_SEC=60
CONSOLE_URL=http://localhost:8080
ENVIRONMENT_NAME=Production
LIVE_ACTIONS_ENABLED=false
HTTP_TIMEOUT_SEC=20
MAX_PAGES=100
AWS_REGION=us-east-1
AWS_SECRET_PREFIX=observability/
AIRFLOW_TRANSPORT=http
AIRFLOW_API_VERSION=v1
AIRFLOW_URL=
AIRFLOW_READ_TOKEN=
AIRFLOW_WRITE_TOKEN=
MWAA_ENVIRONMENT=
MWAA_WRITE_ROLE_ARN=
AIRFLOW_DAGS={"mysql_initial":"mysql_initial_load","mysql_cdc":"mysql_cdc","mongo_initial":"mongo_initial_load","mongo_cdc":"mongo_cdc"}
SYNC_TASK_REGEX=(^|\.)sync(_.*)?$
TENANT_TASK_REGEX=^sync_(?P<tenant>[a-z0-9_]+)$
ONBOARDING_DAG_ID=onboard_tenant
REGISTRY_DAGS_ENABLED=false
AIRBYTE_URL=
AIRBYTE_TOKEN=
AIRBYTE_WRITE_TOKEN=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_CONFIG_URL=
AIRBYTE_WORKSPACE_ID=
AIRBYTE_DESTINATION_ID=
WAREHOUSE_ENGINE=postgres
WAREHOUSE_URL=
WAREHOUSE_LOAD_COLUMN=_airbyte_extracted_at
WAREHOUSE_STATEMENT_TIMEOUT_MS=10000
SOURCE_ALLOWED_CIDRS=[]
MYSQL_BINLOG_RETENTION_SEC=259200
SOURCE_CA_FILE=
AUTH_PROVIDER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ROLES={}
SESSION_HOURS=8
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_ALLOWED_HOSTS=["hooks.slack.com","outlook.office.com"]
SES_FROM_ADDRESS=
SES_TO_ADDRESSES=[]
SNS_TOPIC_ARN=
RETENTION_ENABLED=true
BACKUP_S3_BUCKET=
BACKUP_KMS_KEY_ID=
OBS_DB_PASSWORD=obs_local
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_URL=

# Optional local Compose port; the demo defaults to 8080.
OBS_WEB_PORT=8080
