{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://warehouse-observability-production.up.railway.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://warehouse-observability-production.up.railway.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
