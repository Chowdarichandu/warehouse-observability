# Non-secret live configuration. All credentials are loaded from per-service AWS secrets.
MODE=live
AWS_REGION=us-east-1
ENVIRONMENT_NAME=Production
CONSOLE_URL=https://observability.example.com
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=replace-with-client-id
OIDC_GROUP_ROLES={"data-viewers":"viewer","data-operators":"operator","data-admins":"admin"}
COOKIE_SECURE=true
LIVE_ACTIONS_ENABLED=false
REGISTRY_DAGS_ENABLED=false
AIRFLOW_TRANSPORT=http
AIRFLOW_API_VERSION=v1
AIRFLOW_URL=https://airflow.internal.example.com
AIRFLOW_DAGS={"mysql_initial":"obs_mysql_initial","mysql_cdc":"obs_mysql_cdc","mongo_initial":"obs_mongo_initial","mongo_cdc":"obs_mongo_cdc"}
SYNC_TASK_REGEX=^sync$
AIRBYTE_URL=https://airbyte.internal.example.com/api/public/v1
AIRBYTE_CONFIG_URL=https://airbyte.internal.example.com/api/v1
WAREHOUSE_ENGINE=redshift
WAREHOUSE_LOAD_COLUMN=_airbyte_extracted_at
SOURCE_ALLOWED_CIDRS=["10.0.0.0/8"]
AWS_SECRET_PREFIX=observability/tenants/
NOTIFICATION_ALLOWED_HOSTS=["hooks.slack.com","outlook.office.com"]
POLL_INTERVAL_SEC=120
PLATFORM_CHECK_SEC=60
WAREHOUSE_CHECK_SEC=900
ALERT_INTERVAL_SEC=60
RETENTION_ENABLED=true
